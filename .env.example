# Copy this file to .env and fill in real values. Never commit .env.
#
# SECURITY NOTE: Expo inlines EXPO_PUBLIC_ variables into the compiled app in
# plain text (there is no backend to hide them behind, by design - see
# PLAN.md). Use a key with a spend cap / rate limit, and rotate it after
# the hackathon judging period ends.

# Gemini API key (https://aistudio.google.com/apikey), used by the
# form -> schema engine (Phase 1+) and as the cloud fallback for answer
# parsing / voice.
EXPO_PUBLIC_GEMINI_API_KEY=
